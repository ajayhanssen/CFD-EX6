FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale 1;

xmin 0;  xw 1.992;  xmax 3.22;
ymin -0.5;  ymax 0.5;
zmin 0;  zw 0.55;   zmax 1;

ref 1;

// coarse 26 000
nx1 40;  nx2 25;  ny 20;  nz1 11;  nz2 9;

// medium 63 423
// nx1 54;  nx2 33;  ny 27;  nz1 15;  nz2 12;

// fine 150 336
//nx1 72;  nx2 44;  ny 36;  nz1 20;  nz2 16;

NX1 #calc "int($nx1*$ref + 0.5)";
NX2 #calc "int($nx2*$ref + 0.5)";
NY  #calc "int($ny *$ref + 0.5)";
NZ1 #calc "int($nz1*$ref + 0.5)";
NZ2 #calc "int($nz2*$ref + 0.5)";

vertices
(

    ($xmin $ymin $zmin)  // 0
    ($xw   $ymin $zmin)  // 1
    ($xmax $ymin $zmin)  // 2
    ($xmin $ymax $zmin)  // 3
    ($xw   $ymax $zmin)  // 4
    ($xmax $ymax $zmin)  // 5

    ($xmin $ymin $zw)    // 6
    ($xw   $ymin $zw)    // 7
    ($xmax $ymin $zw)    // 8
    ($xmin $ymax $zw)    // 9
    ($xw   $ymax $zw)    // 10
    ($xmax $ymax $zw)    // 11

    ($xmin $ymin $zmax)  // 12
    ($xw   $ymin $zmax)  // 13
    ($xmax $ymin $zmax)  // 14
    ($xmin $ymax $zmax)  // 15
    ($xw   $ymax $zmax)  // 16
    ($xmax $ymax $zmax)  // 17
);

blocks
(
    hex (0 1 4 3 6 7 10 9)      ($nx1 $ny $nz1) simpleGrading (1 1 1)  // at cube
    hex (1 2 5 4 7 8 11 10)     ($nx2 $ny $nz1) simpleGrading (1 1 1)  // wota
    hex (6 7 10 9 12 13 16 15)  ($nx1 $ny $nz2) simpleGrading (1 1 1)  // aobve cube
    hex (7 8 11 10 13 14 17 16) ($nx2 $ny $nz2) simpleGrading (1 1 1)  // above wota
);

edges ();

boundary
(
    left   { type wall; faces ((0 6 9 3) (6 12 15 9)); }
    right  { type wall; faces ((5 11 8 2) (11 17 14 8)); }
    bottom { type wall; faces ((0 1 7 6) (1 2 8 7) (6 7 13 12) (7 8 14 13)); }
    top    { type wall; faces ((3 9 10 4) (4 10 11 5) (9 15 16 10) (10 16 17 11)); }
    back   { type wall; faces ((0 3 4 1) (1 4 5 2)); }
    front  { type wall; faces ((12 13 16 15) (13 14 17 16)); }
);

mergePatchPairs
(

);

